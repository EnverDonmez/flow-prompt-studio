{
  "name": "flow-prompt-studio",
  "version": "2.2.0",
  "description": "AI film production toolkit: screenplay parser, shot coverage, storyboard generator, ScreenJSON export & AI prompt engine. No backend. Zero-config. One command.",
  "main": "src/index.js",
  "types": "index.d.ts",
  "bin": {
    "fps": "bin/fps.js",
    "flow-prompt-studio": "bin/fps.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "index.d.ts"
  ],
  "scripts": {
    "start": "node bin/fps.js",
    "test": "node --test tests/*.test.js",
    "smoke": "node -e \"const fps = require('./src/index.js'); console.log('Flow Prompt Studio v' + fps.version);\"",
    "lint": "eslint bin/ src/ tests/",
    "lint:fix": "eslint --fix bin/ src/ tests/",
    "format": "prettier --write '**/*.{js,json,md}'"
  },
  "keywords": [
    "screenplay-parser",
    "shot-coverage",
    "shot-list",
    "film-production-tool",
    "offline-first",
    "cli-tool",
    "storyboard",
    "google-flow",
    "veo",
    "ai-video",
    "screenplay",
    "prompt-engineering",
    "film-production",
    "claude-code-skill",
    "deepseek",
    "shot-planning",
    "camera-coverage",
    "flow-agent",
    "image-first"
  ],
  "author": "Flow Prompt Studio",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnverDonmez/flow-prompt-studio.git"
  },
  "homepage": "https://github.com/EnverDonmez/flow-prompt-studio#readme",
  "bugs": {
    "url": "https://github.com/EnverDonmez/flow-prompt-studio/issues"
  }
}
